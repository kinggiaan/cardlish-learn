      { "word": "street", "phonetic": "/striːt/", "meaning_vi": "phố, đường phố" },
      { "word": "big", "phonetic": "/bɪɡ/", "meaning_vi": "to, lớn (kích thước)" },
      { "word": "busy", "phonetic": "/ˈbɪzi/", "meaning_vi": "bận rộn, nhộn nhịp" },
      { "word": "live", "phonetic": "/lɪv/", "meaning_vi": "sống" },
      { "word": "noisy", "phonetic": "/ˈnɔɪzi/", "meaning_vi": "ồn ào, om sòm, huyên náo" },
      { "word": "quiet", "phonetic": "/ˈkwaɪət/", "meaning_vi": "yên tĩnh, tĩnh mịch" },
      { "word": "at, in (+ name of the street / road)", "phonetic": "/ət/, /ɪn/", "meaning_vi": "ở, tại" }
    ]
