  "grammar": {
    "title_vi": "Cách hỏi và trả lời về địa điểm đang sinh sống / đặc điểm của một nơi",
    "examples": [
      { "en": "Where do you live?", "vi": "Bạn sống ở đâu?" },
      { "en": "I live in Flat 9.", "vi": "Tớ sống ở căn hộ số 9." },
      { "en": "I live in Ha Noi.", "vi": "Tớ sống ở Hà Nội." },
      { "en": "I live at 45 Kim Ma Street.", "vi": "Tớ sống ở số nhà 45 phố Kim Mã." },
      { "en": "What's the street like?", "vi": "Phố đó như thế nào?" },
      { "en": "It's busy.", "vi": "Nó nhộn nhịp." },
      { "en": "What's the town like?", "vi": "Thị trấn đó như thế nào?" },
      { "en": "It's big and pretty.", "vi": "Nó to và đẹp." }
    ]
  },
  "phonics": {
    "rules": [
      {
        "suffix": "i",
        "label": "Cách phát âm i = /ɪ/",
        "examples": [
          { "word": "big", "phonetic": "/bɪɡ/" },
          { "word": "chicken", "phonetic": "/ˈtʃɪk.ɪn/" },
          { "word": "six", "phonetic": "/sɪks/" }
        ]
      },
      {
        "suffix": "ee",
        "label": "Cách phát âm ee = /iː/",
